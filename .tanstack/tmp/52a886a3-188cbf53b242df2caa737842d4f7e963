      {faqs.map((faq, i) => (
        <div key={i} className="bg-white rounded-2xl border border-cream-border overflow-hidden">
          <button
            className="w-full text-left px-6 py-5 flex items-center justify-between gap-4"
            onClick={() => setOpen(open === i ? null : i)}
